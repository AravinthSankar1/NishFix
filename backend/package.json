{
  "name": "repair-software-library-backend",
  "version": "1.0.0",
  "description": "Backend API for Mobile Phone Repair Software Library",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma db push && node dist/index.js",
