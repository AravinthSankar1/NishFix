# Server & General Config
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/repair_software_db?schema=public

# Authentication Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-12345!
JWT_EXPIRES_IN=7d

# Default Admin Credentials
ADMIN_EMAIL=admin@repair.local
ADMIN_PASSWORD=AdminPass123!
