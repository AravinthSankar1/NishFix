# Server & General Config
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/repair_software_db?schema=public

# Authentication Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-12345!
JWT_EXPIRES_IN=7d

# Default Admin Credentials
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# ==============================================================
# GOOGLE DRIVE CLOUD STORAGE (100% Free - 15 GB Quota)
# ==============================================================
# Method 1 (Easiest): Place `service-account.json` directly into `backend/`
# Or specify its path:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=service-account.json

# Method 2: Provide Service Account credentials directly via env:
GOOGLE_SERVICE_ACCOUNT_EMAIL=tested-file-storage@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...-----END PRIVATE KEY-----\n"

# Optional: Google Drive folder ID to store all uploads in a specific folder
# (Right-click folder in drive.google.com -> copy link -> get the ID after /folders/...)
GOOGLE_DRIVE_FOLDER_ID=

# Method 3 (Personal Gmail Drive via OAuth2):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
