// Prisma Schema for Mobile Phone Repair Software Library

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERADMIN
  USER
}

enum SoftwareStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Shop Admin")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  phone                String?
  role                 Role      @default(USER)
  deviceLimit          Int       @default(2)
  credits              Int       @default(100)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  uploadedSoftware     Software[]
}

model Software {
  id               String         @id @default(uuid())
  brand            String
  model            String
  softwareName     String
  version          String
  description      String?        @db.Text
  additionalInfo   String?        @db.Text
  category         String?        @default("Firmware & Tools")
  subCategory      String?        @default("Mobile Phone")
  tags             String?        // Comma separated tags
  compatibility    String?        // Chipset, OS, region, etc.
  uploaderName     String?        @default("Official Lab")
  imageObjectKey   String?
  imageUrl         String?
  fileObjectKey    String
  originalFileName String
  fileSize         BigInt
  mimeType         String         @default("application/zip")
  checksum         String?
  externalUrl      String?        // External mirror hyperlink (Google Drive, Mega, etc.)
  downloadCount    Int            @default(0)
  status           SoftwareStatus @default(PUBLISHED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  uploadedByUserId String?
  uploadedByUser   User?          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  downloadLogs     DownloadLog[]

  @@index([brand])
  @@index([model])
  @@index([softwareName])
  @@index([status])
  @@index([subCategory])
  @@index([createdAt])
}

model DownloadLog {
  id           String   @id @default(uuid())
  softwareId   String
  software     Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  downloadedAt DateTime @default(now())

  @@index([softwareId])
  @@index([downloadedAt])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
