# ── NishFix Frontend Environment Variables ──
# Copy this file to .env and fill in your real values.
# All VITE_ prefixed vars are available at build time.

# Brand
VITE_BRAND_NAME=Tested File
VITE_BRAND_TAGLINE=Mobile Repair Software & Firmware Library
VITE_BRAND_SUBTITLE=Tested ROMs, Schematics & Tools

# Contact (leave empty to hide from UI)
VITE_PHONE_1=
VITE_PHONE_2=
VITE_WHATSAPP=
VITE_EMAIL=

# Location (leave empty to hide)
VITE_ADDRESS_SHORT=
VITE_ADDRESS_FULL=
VITE_CITY=

# Hero Section
VITE_HERO_HEADLINE=Find & Download Tested Mobile Repair Software Packages
VITE_HERO_DESCRIPTION=Search official ROM flashing tools, unbrick utilities, firmware, and repair packages for Samsung, Xiaomi, Apple, Oppo, Vivo, and MediaTek devices.

# Statistics Counters (leave empty to hide stats section)
VITE_STAT_TECHNICIANS=
VITE_STAT_SCHEMATICS=
VITE_STAT_SUCCESS_RATE=

# Team / Founder (leave empty to hide team section)
VITE_FOUNDER_NAME=
VITE_FOUNDER_ROLE=
VITE_FOUNDER_DESCRIPTION=
VITE_SHOW_TEAM=false

# Sections visibility
VITE_SHOW_COURSES=false
VITE_SHOW_DISTRIBUTERS=false
VITE_SHOW_WHY_SECTION=true

# Social Media (leave empty to hide)
VITE_YOUTUBE_URL=
VITE_INSTAGRAM_URL=
VITE_TELEGRAM_URL=
